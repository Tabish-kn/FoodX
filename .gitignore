# ==========================================
# FoodX Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build & Compilation Artifacts
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment & Secrets (NEVER COMMIT REAL SECRETS)
.env
.env.*
!.env.example

# Databases & Cache
*.sqlite
*.sqlite3
*.db
prisma/*.db
prisma/*.db-journal

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Flutter & Dart Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
*.apk
*.aab
*.ipa
*.app

# OS & Workspace Files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Test Coverage Reports
coverage/
.nyc_output/
